# Python
__pycache__/
*.py[cod]
*.so
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Node / web tooling
node_modules/
dist/
build/
.next/
out/
coverage/

# Local runtime state
.local/
artifacts/
uploads/
tmp/
.cache/
*.sqlite
*.sqlite3
*.db

# Research / experiment runtime output
runs/
checkpoints/
mlruns/
wandb/

# Secrets and local environment
.env
.env.*
!.env.example

# IDE / operating system
.DS_Store
.idea/
*.swp
*.swo

# Terraform (deploy/terraform): providers, state and the operator's variables stay local; lock files are committed.
deploy/terraform/**/.terraform/
deploy/terraform/**/*.tfstate
deploy/terraform/**/*.tfstate.*
deploy/terraform/**/*.tfvars
deploy/terraform/**/.build/
deploy/terraform/bootstrap/backend.tf
deploy/terraform/**/*.plan

# Credentials that must never be committed.
kaggle.json
*.pem
*.key
