# Hetren MVP v2
#
# This file contains only the initial repository-level environment contract.
# Additional variables are introduced only when the corresponding MVP
# capability is implemented and qualified.

HETREN_ENV=development

# PostgreSQL
DATABASE_URL=postgresql+psycopg://hetren:hetren_local_dev_only@localhost:5432/hetren
TEST_DATABASE_URL=postgresql+psycopg://hetren:hetren_local_dev_only@localhost:5432/hetren_test

# Local artifact root.
# Production/private-runner storage contracts are defined later.
HETREN_ARTIFACT_ROOT=.local/artifacts
