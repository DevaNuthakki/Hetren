# Hetren application environment
HETREN_ENV=development

# SQLAlchemy database connection
DATABASE_URL=postgresql+psycopg://ovrin:ovrin_local_dev_only@localhost:5433/ovrin
TEST_DATABASE_URL=postgresql+psycopg://ovrin:ovrin_local_dev_only@localhost:5433/ovrin_test
DATABASE_ECHO=false

# Local Docker PostgreSQL configuration
POSTGRES_DB=ovrin
POSTGRES_USER=ovrin
POSTGRES_PASSWORD=ovrin_local_dev_only
POSTGRES_PORT=5433

# Standalone local or CI runner configuration
# The credential is returned once by POST /runners/register.
HETREN_RUNNER_API_URL=http://127.0.0.1:8000
HETREN_RUNNER_CREDENTIAL=
HETREN_RUNNER_VERSION=0.1.0
HETREN_RUNNER_CAPABILITIES=["asr","cpu","local"]
HETREN_RUNNER_REQUEST_TIMEOUT_SECONDS=30
HETREN_RUNNER_LEASE_SECONDS=300
HETREN_RUNNER_POLL_INTERVAL_SECONDS=5
HETREN_RUNNER_LEASE_RENEWAL_INTERVAL_SECONDS=60
HETREN_RUNNER_CONTROL_POLL_INTERVAL_SECONDS=2
HETREN_RUNNER_EXECUTION_TIMEOUT_SECONDS=3600

# Runner ASR provider configuration
# Safe default: deterministic local mock provider.
HETREN_RUNNER_ASR_PROVIDER=mock_local
HETREN_RUNNER_ASR_MODEL=mock-asr-foundation
HETREN_RUNNER_ASR_DEVICE=cpu
HETREN_RUNNER_ASR_COMPUTE_TYPE=int8
