# Ovrin application environment
OVRIN_ENV=development

# SQLAlchemy database connection
DATABASE_URL=postgresql+psycopg://ovrin:ovrin_local_dev_only@localhost:5433/ovrin
TEST_DATABASE_URL=postgresql+psycopg://ovrin:ovrin_local_dev_only@localhost:5433/ovrin_test
DATABASE_ECHO=false

# Local Docker PostgreSQL configuration
POSTGRES_DB=ovrin
POSTGRES_USER=ovrin
POSTGRES_PASSWORD=ovrin_local_dev_only
POSTGRES_PORT=5433

# Standalone local or CI runner configuration
# The credential is returned once by POST /runners/register.
OVRIN_RUNNER_API_URL=http://127.0.0.1:8000
OVRIN_RUNNER_CREDENTIAL=
OVRIN_RUNNER_VERSION=0.1.0
OVRIN_RUNNER_CAPABILITIES=["asr","cpu","local"]
OVRIN_RUNNER_REQUEST_TIMEOUT_SECONDS=30
OVRIN_RUNNER_LEASE_SECONDS=300
OVRIN_RUNNER_POLL_INTERVAL_SECONDS=5
OVRIN_RUNNER_LEASE_RENEWAL_INTERVAL_SECONDS=60
