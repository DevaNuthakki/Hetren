  "generic_environment_self_consistency_hardening": {
    "version": "1.0.0",
    "purpose": "Reject internally inconsistent generated case descriptions before any protected target execution without exposing historical holdout cases or evaluator behavior.",
    "timing": "AFTER_ALL_CASES_ARE_GENERATED_AND_BEFORE_RETURNING_SUCCESS_OUTPUT",
    "target_evaluator_execution_required": false,
    "target_evaluator_simulation_required": false,
    "rules": [
      "Every case must describe one internally coherent evaluated environment.",
      "For a non-CROSS_ENV case, any explicit E1, E2, or E3 token used by environment-scoped facts to identify the concrete evaluated environment must agree with the case top-level environment.",
      "For a CROSS_ENV case, explicit environment references may contain more than one of E1, E2, and E3 only when the cross-environment interaction is material and explicitly described.",
      "If environment_binding is present and the case environment is not CROSS_ENV, an explicit environment identifier in environment_binding must not identify a different environment.",
      "For G3-BR-027 NOT_APPLICABLE cases, the environment binding, applicability facts, rationale, and adversarial description must all support the same environment-scoped applicability interpretation.",
      "Rationale and adversarial description must not contradict the environment represented by the structured case fields.",
      "A case failing environment self-consistency must be revised inside the generation process before the single final success artifact is returned."
    ],
    "deterministic_preflight": {
      "required": true,
      "explicit_environment_tokens": [
        "E1",
        "E2",
        "E3"
      ],
      "non_cross_environment_binding_rule": "IF facts.environment_binding contains explicit E1/E2/E3 tokens AND case.environment is not CROSS_ENV, every such token that identifies the evaluated environment must equal case.environment.",
      "mismatch_count_required_value": 0
    },
    "semantic_preflight": {
      "required": true,
      "review_surfaces": [
        "environment",
        "environment-scoped facts",
        "environment_binding when present",
        "rationale",
        "adversarial_dimension"
      ],
      "required_result": "NO_INTERNAL_ENVIRONMENT_CONTRADICTION"
    },
    "required_success_preflight_evidence": {
      "environment_self_consistency_checked": true,
      "environment_self_consistency_passed": true,
      "environment_binding_token_mismatch_count": 0,
      "semantic_environment_consistency_review_passed": true
    }
  },
