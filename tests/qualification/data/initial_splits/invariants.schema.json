{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hetren://task7/initial-splits/invariants.schema.json",
  "title": "Task 7 Initial Splits Invariant Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task",
    "registry_id",
    "authority",
    "decision_id",
    "purpose",
    "important_interpretation",
    "invariant_count",
    "invariants"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "task": {
      "const": 7
    },
    "registry_id": {
      "const": "TASK7-INITIAL-SPLITS-INVARIANTS"
    },
    "authority": {
      "const": "AUTH-HETREN-MVP-3.0"
    },
    "decision_id": {
      "const": "0008"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "important_interpretation": {
      "type": "string",
      "minLength": 1
    },
    "invariant_count": {
      "type": "integer",
      "minimum": 1
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/invariant"
      }
    }
  },
  "$defs": {
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invariant_id",
        "label",
        "enforcement_kind",
        "helper",
        "source_file",
        "source_line",
        "status"
      ],
      "properties": {
        "invariant_id": {
          "type": "string",
          "pattern": "^T7\\.INV\\.[a-z0-9]+(?:\\.[a-z0-9]+)*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "enforcement_kind": {
          "enum": [
            "SEMANTIC_HELPER",
            "DISTRIBUTED_COMPOSITION"
          ]
        },
        "helper": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_file": {
          "const": "scripts/check_initial_splits.py"
        },
        "source_line": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "const": "ACTIVE"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enforcement_kind": {
                "const": "SEMANTIC_HELPER"
              }
            },
            "required": [
              "enforcement_kind"
            ]
          },
          "then": {
            "properties": {
              "helper": {
                "enum": [
                  "forbid_semantic_patterns",
                  "forbid_permissive_relationship",
                  "forbid_permissive_paragraph_relationship",
                  "forbid_concept_cooccurrence",
                  "forbid_cross_document_composition"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "enforcement_kind": {
                "const": "DISTRIBUTED_COMPOSITION"
              }
            },
            "required": [
              "enforcement_kind"
            ]
          },
          "then": {
            "properties": {
              "helper": {
                "type": "null"
              },
              "invariant_id": {
                "const": "T7.INV.baseline.resource.composition.integrity"
              },
              "label": {
                "const": "baseline-resource composition integrity"
              }
            }
          }
        }
      ]
    }
  }
}
