{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hetren://task7/initial-splits/positive-cases.schema.json",
  "title": "Task 7 Initial Splits Positive Qualification Cases",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task",
    "dataset_id",
    "authority",
    "decision_id",
    "purpose",
    "interpretation",
    "positive_case_count",
    "family_count",
    "variants_per_family",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "task": {
      "const": 7
    },
    "dataset_id": {
      "const": "TASK7-INITIAL-SPLITS-POSITIVE-CASES"
    },
    "authority": {
      "const": "AUTH-HETREN-MVP-3.0"
    },
    "decision_id": {
      "const": "0008"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "interpretation": {
      "type": "string",
      "minLength": 1
    },
    "positive_case_count": {
      "const": 24
    },
    "family_count": {
      "const": 8
    },
    "variants_per_family": {
      "const": 3
    },
    "cases": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "family_id",
        "family",
        "variant",
        "expected",
        "related_invariant_ids",
        "operations"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^T7-POS-C0[1-8]-0[1-3]$"
        },
        "family_id": {
          "type": "string",
          "pattern": "^C0[1-8]$"
        },
        "family": {
          "type": "string",
          "minLength": 1
        },
        "variant": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "expected": {
          "const": "MUST_ACCEPT"
        },
        "related_invariant_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^T7\\.INV\\.[a-z0-9]+(?:\\.[a-z0-9]+)*$"
          }
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/specOperation"
              },
              {
                "$ref": "#/$defs/decisionOperation"
              }
            ]
          }
        }
      }
    },
    "specOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "document",
        "section_number",
        "section_title",
        "addition"
      ],
      "properties": {
        "operation": {
          "const": "APPEND_SPEC_SECTION"
        },
        "document": {
          "const": "SPEC"
        },
        "section_number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "section_title": {
          "type": "string",
          "minLength": 1
        },
        "addition": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "decisionOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "document",
        "section_title",
        "addition"
      ],
      "properties": {
        "operation": {
          "const": "APPEND_DECISION_SECTION"
        },
        "document": {
          "const": "DECISION"
        },
        "section_title": {
          "type": "string",
          "minLength": 1
        },
        "addition": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
